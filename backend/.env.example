# ============================================================
#  ARIA NEXUS — Secret Configuration
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to git (it contains secrets).
# ============================================================

# Home Assistant Long-Lived Access Token
# Generate at: http://127.0.0.1:8123 → Profile → Long-Lived Access Tokens
HA_TOKEN=paste_your_token_here

# Home Assistant base URL (change if HA runs on a different host/port)
HA_URL=http://127.0.0.1:8123

# Optional: Flask secret key (auto-generated if not set)
# FLASK_SECRET_KEY=some-random-string
